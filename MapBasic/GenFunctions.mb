Function TableIsOpen (ByVal sTabName As String) As Logical
'*************************************************
'* Check if the table is open
'*************************************************

	'-------------------------------------------------
	' Determine the number of open tables
	'-------------------------------------------------
	Dim iCounter, iNumberOfTables As Integer
	iNumberOfTables = NumTables()

	'-------------------------------------------------
	' Return FALSE if there are no open tables
	'-------------------------------------------------
	If iNumberOfTables = 0 Then
		TableIsOpen = FALSE
		Exit Function
	End If

	'-------------------------------------------------
	' Loop through the open tables looking for the
	' require table name. If found return TRUE
	'-------------------------------------------------
	For iCounter = 1 to iNumberOfTables
		If TableInfo(iCounter, TAB_INFO_NAME) = sTabName Then
			TableIsOpen = TRUE
			Exit Function
		End If
	Next

End Function

Function ColumnExists(ByVal sTableName As String, ByVal sColName As String) As Logical
'*************************************************
'* Check if the column exists in the table
'*************************************************

	'-------------------------------------------------
	' Loop through all the columns looking for the
	' required name
	'-------------------------------------------------
	Dim i, j As Integer
	Dim sColName0 As String

	ColumnExists = False

	For i = 1 to TableInfo(sTableName, TAB_INFO_NCOLS)
 
       sColName0 = ColumnInfo(sTableName, "col"&i, COL_INFO_NAME)
		If UCase$(sColName) = UCase$(sColName0) Then
 			ColumnExists = True
			Exit For
		End If

	Next

End Function

Function ExecuteAndWait(ByVal cmdLine As String) As Integer
'*************************************************
'* Execute a command and wait for it to finish.
'* Returns the process exit code, or -1 if the
'* process itself could not be executed/queried.
'*************************************************

	OnError Goto ErrorHandle

	Dim nRetVal As Integer
	Dim nResult As Integer
	Dim nExitCode As Integer
	Dim NameOfProc As PROCESS_INFORMATION
	Dim NameStart As STARTUPINFO
	Dim hProc As Integer

	NameStart.cb = 256
	NameStart.dwFlags = 1
	NameStart.wShowWindow = 0

	'-------------------------------------------------
	' Start the application
	'-------------------------------------------------
	nRetVal = CreateProcessA( 0, cmdLine, 0, 0, 1, NORMAL_PRIORITY_CLASS, 0, 0, NameStart, NameOfProc)

	If nRetVal = 0 Then
		ExecuteAndWait = -1
		Exit Function
	End If

	hProc = NameOfProc.hProcess

	'-------------------------------------------------
	' Wait for the process to finish
	'-------------------------------------------------
	nRetVal = WaitForSingleObject(hProc, INFINITE)

	If nRetVal = -1 Then
		nResult = CloseHandle(NameOfProc.hProcess)
		nResult = CloseHandle(NameOfProc.hThread)
		ExecuteAndWait = -1
		Exit Function
	End If

	'-------------------------------------------------
	' Retrieve its exit code
	'-------------------------------------------------
	nRetVal = GetExitCodeProcess(hProc, nExitCode)

	If nRetVal = 0 Then
		nResult = CloseHandle(NameOfProc.hProcess)
		nResult = CloseHandle(NameOfProc.hThread)
		ExecuteAndWait = -1
		Exit Function
	End If

	'-------------------------------------------------
	' Close both handles returned by CreateProcess
	'-------------------------------------------------
	nResult = CloseHandle(NameOfProc.hProcess)
	nResult = CloseHandle(NameOfProc.hThread)

	ExecuteAndWait = nExitCode
	Exit Function

ErrorHandle:

	ExecuteAndWait = -1

	Note Str$(Err()) + ": " + Error$()
	Call MyPrint(Str$(Err()) + ": " + Error$())

	Exit Function

End Function

Function WindowsZipTool(ByVal sName As String) As String
' Use the native system directory, including from 32-bit MapInfo on 64-bit Windows.
    Dim sWindows As String, sCandidate As String
    WindowsZipTool = ""
    sWindows = FullPath(Env$("WINDIR"))
    If sWindows = "" Then Exit Function End If
    sCandidate = sWindows + "\Sysnative\" + sName
    If FileExists(sCandidate) Then
        WindowsZipTool = sCandidate
        Exit Function
    End If
    sCandidate = sWindows + "\System32\" + sName
    If FileExists(sCandidate) Then WindowsZipTool = sCandidate End If
End Function

Function InitZipTools() As Logical
    Dim sQ As String, iResult As Integer
    InitZipTools = False
    sQ = Chr$(34)
    sZipTar = WindowsZipTool("tar.exe")
    sZipCompare = WindowsZipTool("fc.exe")
    If sZipTar = "" Or sZipCompare = "" Then
        Call MyPrint("ZIP creation requires Windows tar.exe and fc.exe. No source files have been removed.")
        Exit Function
    End If
    iResult = ExecuteAndWait(sQ + sZipTar + sQ + " --version")
    If iResult <> 0 Then
        Call MyPrint("Unable to run Windows tar.exe. Exit code = " + Str$(iResult))
        Exit Function
    End If
    iResult = ExecuteAndWait(sQ + sZipCompare + sQ + " /?")
    If iResult <> 0 Then
        Call MyPrint("Unable to run Windows fc.exe. Exit code = " + Str$(iResult))
        Exit Function
    End If
    InitZipTools = True
End Function

Function ZipExcludePattern(ByVal sName As String) As String
' Anchor the exclusion at the root and quote literal pattern metacharacters.
    Dim i As Integer, sChar As String, sPattern As String
    sPattern = "^./"
    For i = 1 To Len(sName)
        sChar = Mid$(sName, i, 1)
        Do Case sChar
            Case "[", "]", "^", "$"
                sPattern = sPattern + "\" + sChar
            Case Else
                sPattern = sPattern + sChar
        End Case
    Next
    ZipExcludePattern = sPattern + "$"
End Function

Function IsZipArchive(ByVal sPath As String) As Logical
' Validate the format as well as tar's return code (ZIP local-file header).
    OnError Goto Failed
    Dim iSignature As Integer, bOpened As Logical
    IsZipArchive = False
    Open File sPath For Binary Access Read As #94 ByteOrder LOWHIGH
    bOpened = True
    Get #94, , iSignature
    Close File #94
    bOpened = False
    IsZipArchive = iSignature = 67324752
    Exit Function
Failed:
    If bOpened Then Close File #94 End If
End Function

Function SnapshotZipFolder(ByVal sRoot As String, ByVal sRelative As String,
    ByVal sExcluded As String, entries() As ZIP_ENTRY, count As Integer) As Logical
' Enumerate with local search state: recursion must not overwrite its parent's handle.
    OnError Goto Failed
    Dim state As ZIP_NATIVE_HANDLE, data As WIN32_FIND_DATA
    Dim sName As String, sChild As String, sPath As String
    Dim iResult As Integer, iError As Integer
    Dim bOpened As Logical, bDirectory As Logical
    SnapshotZipFolder = False
    state.Value = FindFirstFile(sRoot + "\" + sRelative + "*", data)
    If state.Value = -1 Then
        iError = ZipLastError()
        If iError = 2 Then SnapshotZipFolder = True End If
        Exit Function
    End If
    bOpened = True
    Do
        sName = RTrim$(data.cFileName)
        If sName <> "." And sName <> ".." Then
            sChild = sRelative + sName
            sPath = sRoot + "\" + sChild
            bDirectory = (data.dwFileAttributes Mod 32) >= 16
            If UCase$(sPath) <> UCase$(sExcluded) Or bDirectory Then
                If (data.dwFileAttributes Mod 2048) >= 1024 Then
                    Call MyPrint("ZIP source contains a link or junction: '" + sPath + "'.")
                    Goto Failed
                End If
                count = count + 1
                If count > UBound(entries) Then ReDim entries(count + 100) End If
                entries(count).Name = sChild
                entries(count).IsDirectory = bDirectory
                entries(count).SizeHigh = data.nFileSizeHigh
                entries(count).SizeLow = data.nFileSizeLow
                entries(count).ModifiedHigh = data.ftLastWriteTime.dwHighDateTime
                entries(count).ModifiedLow = data.ftLastWriteTime.dwLowDateTime
                If bDirectory Then
                    If Not SnapshotZipFolder(sRoot, sChild + "\", sExcluded, entries(), count) Then Goto Failed End If
                End If
            End If
        End If
        iResult = FindNextFile(state.Value, data)
        If iResult = 0 Then
            iError = ZipLastError()
            If iError <> 18 Then Goto Failed End If
            Exit Do
        End If
    Loop
    iResult = FindClose(state.Value)
    bOpened = False
    SnapshotZipFolder = True
    Exit Function
Failed:
    If bOpened Then iResult = FindClose(state.Value) End If
End Function

Function ZipEntryUnchanged(ByVal sRoot As String, entry As ZIP_ENTRY) As Logical
    OnError Goto Failed
    Dim state As ZIP_NATIVE_HANDLE, data As WIN32_FIND_DATA
    Dim iResult As Integer, bDirectory As Logical
    ZipEntryUnchanged = False
    state.Value = FindFirstFile(sRoot + "\" + entry.Name, data)
    If state.Value = -1 Then Exit Function End If
    iResult = FindClose(state.Value)
    If (data.dwFileAttributes Mod 2048) >= 1024 Then Exit Function End If
    bDirectory = (data.dwFileAttributes Mod 32) >= 16
    If bDirectory <> entry.IsDirectory Then Exit Function End If
    If Not bDirectory Then
        If data.nFileSizeHigh <> entry.SizeHigh Or data.nFileSizeLow <> entry.SizeLow Then Exit Function End If
        If data.ftLastWriteTime.dwHighDateTime <> entry.ModifiedHigh Or data.ftLastWriteTime.dwLowDateTime <> entry.ModifiedLow Then Exit Function End If
    End If
    ZipEntryUnchanged = True
Failed:
End Function

Function VerifyZipFolder(ByVal sSource As String, ByVal sRestored As String,
    ByVal sExcluded As String, entries() As ZIP_ENTRY, ByVal count As Integer) As Logical
    OnError Goto Failed
    Dim currentEntries() As ZIP_ENTRY, restoredEntries() As ZIP_ENTRY
    Dim iCurrent As Integer, iRestored As Integer, i As Integer, iResult As Integer
    Dim sCommand As String, sQ As String, iAttributes As Integer
    VerifyZipFolder = False
    ReDim currentEntries(100)
    ReDim restoredEntries(100)
    If Not SnapshotZipFolder(sSource, "", sExcluded, currentEntries(), iCurrent) Then Exit Function End If
    If Not SnapshotZipFolder(sRestored, "", "", restoredEntries(), iRestored) Then Exit Function End If
    If iCurrent <> count Or iRestored <> count Then
        Call MyPrint("ZIP verification failed: the source or restored inventory changed.")
        Exit Function
    End If
    sQ = Chr$(34)
    For i = 1 To count
        If Not ZipEntryUnchanged(sSource, entries(i)) Then
            Call MyPrint("ZIP source changed: '" + entries(i).Name + "'.")
            Exit Function
        End If
        iAttributes = GetFileAttributes(sRestored + "\" + entries(i).Name)
        If iAttributes = -1 Then Exit Function End If
        If ((iAttributes Mod 32) >= 16) <> entries(i).IsDirectory Then Exit Function End If
        If Not entries(i).IsDirectory Then
            sCommand = sQ + sZipCompare + sQ + " /b " + sQ + sSource + "\" + entries(i).Name + sQ + " " + sQ + sRestored + "\" + entries(i).Name + sQ
            iResult = ExecuteAndWait(sCommand)
            If iResult <> 0 Then
                Call MyPrint("ZIP byte comparison failed for '" + entries(i).Name + "'. Exit code = " + Str$(iResult))
                Exit Function
            End If
        End If
    Next
    ' Catch changes made while the byte comparisons were running.
    iCurrent = 0
    If Not SnapshotZipFolder(sSource, "", sExcluded, currentEntries(), iCurrent) Then Exit Function End If
    If iCurrent <> count Then Exit Function End If
    For i = 1 To count
        If Not ZipEntryUnchanged(sSource, entries(i)) Then Exit Function End If
    Next
    VerifyZipFolder = True
Failed:
End Function

Function ZipFiles(sDefaultPath As String, sShortName As String) As Integer
' 0: verified and cleaned; 1: empty; 2: failure, with originals/recovery files retained.
    OnError Goto ZipError
    Dim entries() As ZIP_ENTRY
    Dim state As ZIP_NATIVE_HANDLE, data As WIN32_FIND_DATA
    Dim sExcludedName As String
    Dim sFolder As String, sZipName As String, sTarget As String, sWork As String
    Dim sCandidate As String, sRestored As String, sCommand As String, sQ As String
    Dim iPos As Integer, iResult As Integer, count As Integer, i As Integer
    Dim iAttributes As Integer, bPublished As Logical
    ZipFiles = 2
    If sZipTar = "" Or sZipCompare = "" Then
        If Not InitZipTools() Then Exit Function End If
    End If
    sFolder = FullPath(sDefaultPath + "\" + sShortName)
    If Not PathIsWithin(sFolder, FullPath(sDefaultPath)) Then Goto Failed End If
    iAttributes = GetFileAttributes(sFolder)
    If iAttributes = -1 Then Goto Failed End If
    If (iAttributes Mod 2048) >= 1024 Then Goto Failed End If
    sZipName = sFolder
    iPos = Len(sZipName)
    Do While iPos > 0
        If Mid$(sZipName, iPos, 1) = "\" Then Exit Do End If
        iPos = iPos - 1
    Loop
    sZipName = Mid$(sZipName, iPos + 1) + ".zip"
    sTarget = sFolder + "\" + sZipName
    sExcludedName = sZipName
    state.Value = FindFirstFile(sTarget, data)
    If state.Value <> -1 Then
        sExcludedName = RTrim$(data.cFileName)
        iResult = FindClose(state.Value)
    End If
    ReDim entries(100)
    If Not SnapshotZipFolder(sFolder, "", sTarget, entries(), count) Then Goto Failed End If
    If count = 0 Then
        Call MyPrint("No files to compress.")
        ZipFiles = 1
        Exit Function
    End If
    sWork = NewWorkingFolder(sDefaultPath, "DataExtractorZip")
    If sWork = "" Then Goto Failed End If
    sCandidate = sWork + "\candidate.zip"
    sRestored = sWork + "\verified"
    If Not CreatePath(sRestored) Then Goto Failed End If
    sQ = Chr$(34)
    Call MyPrint("Creating ZIP '" + sTarget + "' using Windows tar.exe ...")
    sCommand = sQ + sZipTar + sQ + " -a -c -f " + sQ + sCandidate + sQ + " --exclude " + sQ + ZipExcludePattern(sExcludedName) + sQ + " -C " + sQ + sFolder + sQ + " ."
    iResult = ExecuteAndWait(sCommand)
    If iResult <> 0 Then
        Call MyPrint("ZIP creation failed. Exit code = " + Str$(iResult))
        Goto Failed
    End If
    If Not IsZipArchive(sCandidate) Then
        Call MyPrint("Windows tar.exe did not create a valid ZIP file.")
        Goto Failed
    End If
    Call MyPrint("Extracting and verifying ZIP contents ...")
    sCommand = sQ + sZipTar + sQ + " -x -f " + sQ + sCandidate + sQ + " -C " + sQ + sRestored + sQ
    iResult = ExecuteAndWait(sCommand)
    If iResult <> 0 Then
        Call MyPrint("ZIP verification extraction failed. Exit code = " + Str$(iResult))
        Goto Failed
    End If
    If Not VerifyZipFolder(sFolder, sRestored, sTarget, entries(), count) Then Goto Failed End If
    ' Same-volume rename: the previous archive stays intact if publication fails.
    iResult = ZipMoveFileEx(sCandidate, sTarget, 9)
    If iResult = 0 Then Goto Failed End If
    bPublished = True
    For i = 1 To count
        If Not entries(i).IsDirectory Then
            If Not ZipEntryUnchanged(sFolder, entries(i)) Then Goto Failed End If
            Kill sFolder + "\" + entries(i).Name
        End If
    Next
    For i = count To 1 Step -1
        If entries(i).IsDirectory Then
            iResult = RemoveDirectory(sFolder + "\" + entries(i).Name)
            If iResult = 0 Then Goto Failed End If
        End If
    Next
    ' Clean only the exact restored files/directories; never recursively delete a tree.
    For i = 1 To count
        If Not entries(i).IsDirectory Then Kill sRestored + "\" + entries(i).Name End If
    Next
    For i = count To 1 Step -1
        If entries(i).IsDirectory Then
            iResult = RemoveDirectory(sRestored + "\" + entries(i).Name)
            If iResult = 0 Then Goto Failed End If
        End If
    Next
    iResult = RemoveDirectory(sRestored)
    If iResult = 0 Then Goto Failed End If
    iResult = RemoveDirectory(sWork)
    If iResult = 0 Then Goto Failed End If
    Call MyPrint("ZIP contents verified byte for byte; source files removed.")
    ZipFiles = 0
    Exit Function
Failed:
    Call MyPrint("Error creating, verifying or cleaning ZIP '" + sTarget + "'.")
    If bPublished Then Call MyPrint("The verified ZIP is available; check remaining source files.") End If
    If sWork <> "" Then Call MyPrint("ZIP recovery files retained in '" + sWork + "'.") End If
    Exit Function
ZipError:
    Call MyPrint("ZIP file operation failed: " + Str$(Err()) + " - " + Error$())
    Goto Failed
End Function

Function STLText2Symbol(ByVal sSymbol As String) As Symbol
'*************************************************
'* Convert style text string to symbol
'*************************************************
Dim arrItems() As String, nNumItems As Integer
OnError GoTo ErrorOccured

nNumItems = StringSplit(sSymbol, ",", arrItems)

If nNumItems = 3 Then
	'MapInfo 3.0 symbol set
	STLText2Symbol = MakeSymbol(Val(arrItems(1)), Val(arrItems(2)), Val(arrItems(3)))
ElseIf nNumItems > 3 Then
	Do Case arrItems(1)
		Case "1"
			'MapInfo 3.0 symbol set
			STLText2Symbol = MakeSymbol(Val(arrItems(2)), Val(arrItems(3)), Val(arrItems(4)))
		Case "2"
			'TrueType font as the symbol
			STLText2Symbol = MakeFontSymbol(Val(arrItems(2)), Val(arrItems(3)), Val(arrItems(4)), arrItems(5), Val(arrItems(6)), Val(arrItems(7)))
		Case "3"
			'Symbol value based on a bitmap file
			STLText2Symbol = MakeCustomSymbol(arrItems(2), Val(arrItems(3)), Val(arrItems(4)), Val(arrItems(5)))
	End Case
End If

Exit Function
'-------------------------
ErrorOccured:
	STLText2Symbol = CurrentSymbol()
End Function

Function STLText2Pen(ByVal sSymbol As String) As Pen
'*************************************************
'* Convert style text string to pen
'*************************************************
Dim arrItems() As String, nNumItems As Integer
OnError GoTo ErrorOccured

nNumItems = StringSplit(sSymbol, ",", arrItems)

If nNumItems = 3 Then
	STLText2Pen = MakePen(Val(arrItems(1)), Val(arrItems(2)), Val(arrItems(3)))
End If

Exit Function
'-------------------------
ErrorOccured:
	STLText2Pen = CurrentPen()
End Function

Function STLText2Brush(ByVal sSymbol As String) As Brush
'*************************************************
'* Convert style text string to brush
'*************************************************
Dim arrItems() As String, nNumItems As Integer
OnError GoTo ErrorOccured

nNumItems = StringSplit(sSymbol, ",", arrItems)

If nNumItems = 2 Then
	STLText2Brush = MakeBrush(Val(arrItems(1)), Val(arrItems(2)), -1)
ElseIf nNumItems = 3 Then
	STLText2Brush = MakeBrush(Val(arrItems(1)), Val(arrItems(2)), Val(arrItems(3)))
End If

Exit Function
'-------------------------
ErrorOccured:
	STLText2Brush = CurrentBrush()
End Function

Function StringSplit(ByVal sText As String, ByVal sSplitChar As String, arrParts() As String) As Integer
'*************************************************
'* Splits a comma delimeted string into separate
'* values in an array
'*************************************************
	Dim sCopy As String, nBeg, nEnd As Integer, nCount As Integer 
	OnError GoTo ErrorOccured 
	nEnd = 0 
	nCount = 0 
	sCopy = UCase$(sText) 
	
	Do While nEnd <= Len(sCopy) 
		nBeg = nEnd + 1 
		nEnd = InStr(nBeg, sCopy, sSplitChar) 
		If nEnd = 0 Then 
			nEnd = Len(sCopy) + 1 
		End If 
		nCount = nCount + 1 
		ReDim arrParts(nCount) 
		If nBeg = nEnd Then 
			arrParts(nCount) = "" 
		Else 
			arrParts(nCount) = Mid$(sText, nBeg, nEnd - nBeg) 
		End If 
	Loop 
	STRINGSplit = nCount 

	Exit Function 
'------------------------- 
ErrorOccured: 
End Function

Function StringReplace(ByVal sToBeSearched As String, ByVal sSearchFor As String, ByVal sReplaceWith As String) As String
'*************************************************
'* Finds and replaces one string with another
'* in a given string
'*************************************************

Dim i, nLenR, nLenS As Integer
OnError GoTo ErrorOccured

STRINGReplace = sToBeSearched

nLenR = Len(sReplaceWith)
nLenS = Len(sSearchFor)
i = InStr(1, sToBeSearched, sSearchFor)
Do While i > 0
   sToBeSearched = Left$(sToBeSearched,i - 1) + sReplaceWith
               + Right$(sToBeSearched, Len(sToBeSearched) - ((i - 1) + nLenS))
   i = InStr(i + nLenR, sToBeSearched, sSearchFor)
Loop
STRINGReplace = sToBeSearched

Exit Function

'-------------------------
ErrorOccured:

End Function

Function GetRowLength(ByVal sTableName As String) As Integer
'*************************************************
'* Calculate the total row length for a table
'*************************************************

	'-------------------------------------------------
	' Loop through all the columns in the table and
	' sum the column lengths
	'-------------------------------------------------
	Dim i As Integer
	Dim iRowLength As Integer
	Dim iColumnType As SmallInt
	iRowLength = 1

	For i = 1 to TableInfo(sTableName, TAB_INFO_NCOLS)
 
       iColumnType = ColumnInfo(sTableName, "col"&i, COL_INFO_TYPE)

		Do Case iColumnType
			Case 1
				iRowLength = iRowLength + ColumnInfo(sTableName, "col"&i, COL_INFO_WIDTH)
			Case 2
				iRowLength = iRowLength + ColumnInfo(sTableName, "col"&i, COL_INFO_WIDTH)
			Case 3
				iRowLength = iRowLength + 4
			Case 4
				iRowLength = iRowLength + 2
			Case 5
				iRowLength = iRowLength + 4
			Case 6
				iRowLength = iRowLength + 1
			Case 8
				iRowLength = iRowLength + 8
			Case 37
				iRowLength = iRowLength + 4
			Case 38
				iRowLength = iRowLength + 8
			Case Else
				Call MyPrint("Column type " + iColumnType + " unrecognised.  Column length unknown")
		End Case

	Next

	GetRowLength = iRowLength

End Function

Function GetUserID() As String
'*************************************************
'* Get the User ID of the current user
'*************************************************

	'-------------------------------------------------
	' Loop through all the columns in the table and
	' sum the column lengths
	'-------------------------------------------------
	Dim sUserID As String ' receives name of the user
	Dim iLength As Integer ' length of the string
	Dim iRetVal As Integer ' return value

	'-------------------------------------------------
	' Create room in the buffer to receive the returned string
	'-------------------------------------------------
	sUserID = Space$(255)
	iLength = 255

	'-------------------------------------------------
	' Get the user id
	'-------------------------------------------------
	iRetVal = GetUserName(sUserID, iLength)

	'-------------------------------------------------
	' Extract the returned info from the buffer
	'-------------------------------------------------
	sUserID = Left$(sUserID, iLength - 1)

	GetUserID = sUserID

End Function

Function MonthNumToShortName(ByVal iMonthNo As Integer) As String
'*************************************************
'* Converts a month number to a short name
'* eg 3 -> Mar
'*************************************************

	Do Case iMonthNo
		Case 1
			MonthNumToShortName = "Jan"
		Case 2
			MonthNumToShortName = "Feb"
		Case 3
			MonthNumToShortName = "Mar"
		Case 4
			MonthNumToShortName = "Apr"
		Case 5
			MonthNumToShortName = "May"
		Case 6
			MonthNumToShortName = "Jun"
		Case 7
			MonthNumToShortName = "Jul"
		Case 8
			MonthNumToShortName = "Aug"
		Case 9
			MonthNumToShortName = "Sep"
		Case 10
			MonthNumToShortName = "Oct"
		Case 11
			MonthNumToShortName = "Nov"
		Case 12
			MonthNumToShortName = "Dec"
	End Case
	
End Function

Function MonthNumToQuarter(ByVal iMonthNo As Integer) As String
'*************************************************
'* Converts a month number to a financial
'* quarter, eg 3 -> Q4
'*************************************************

	Do Case iMonthNo
		Case 1, 2, 3
			MonthNumToQuarter = "Q4"
		Case 4, 5, 6
			MonthNumToQuarter = "Q1"
		Case 7, 8, 9
			MonthNumToQuarter = "Q2"
		Case 10, 11, 12
			MonthNumToQuarter = "Q3"
	End Case
	
End Function

Function MonthNumToFinancialYear(ByVal iMonthNo As Integer, ByVal iYear As Integer) As String
'*************************************************
'* Converts a month and year to a financial
'* year, eg 3, 2020 -> 19-20
'*************************************************

	Do Case iMonthNo
		Case 1, 2, 3
			MonthNumToFinancialYear = Format$(iYear - 1, "00") + "-" + Format$(iYear, "00")
		Case 4, 5, 6
			MonthNumToFinancialYear = Format$(iYear, "00") + "-" + Format$(iYear + 1, "00")
		Case 7, 8, 9
			MonthNumToFinancialYear = Format$(iYear, "00") + "-" + Format$(iYear + 1, "00")
		Case 10, 11, 12
			MonthNumToFinancialYear = Format$(iYear, "00") + "-" + Format$(iYear + 1, "00")
	End Case
	
End Function

Function GetFileList(ByVal sFilePath as String, ByVal sFileFilter as String, sFileList() as String, sFileExclude As String) as Logical
'*************************************************
'* Get a list of files from a directory
'*************************************************
OnError Goto CatchEx
   
   Dim sFileName as String
   Dim sSubDirFileList() As String

   Dim iReturn as Integer 
   iReturn = 1
   
   Dim i as Integer, j as Integer
   i = 1 

   hFind = FindFirstFile(sFilePath & sFileFilter, wfd)

   sFileName = LTrim$(RTrim$(wfd.cFileName))
   
   If Len(sFileName) > 0 Then

      Do While iReturn <> 0

         If sFileName = "." or sFileName = ".." Then
            iReturn = FindNextFile(hFind, wfd)
            sFileName = LTrim$(RTrim$(wfd.cFileName))
         Else
           	sFileName = LTrim$(RTrim$(wfd.cFileName))
            If wfd.dwFileAttributes = FILE_ATTRIBUTE_DIRECTORY Then
               iReturn = GetFileList(sFilePath & sFileName & "\", sFileFilter, sSubDirFileList(), sFileExclude)
               For j = 1 to Ubound(sSubDirFileList)
                  ReDim sFileList(i)
                  sFileList(i) = sSubDirFileList(j)
                  i = i + 1 
               Next
               iReturn = FindNextFile(hFind, wfd)
            Else
               If UCase$(sFileName) <> UCase$(sFileExclude) Then
                   ReDim sFileList(i)
                   sFileList(i) = Left$(sFileName, Len(sFileName) - Len(sFileFilter) + 1)
	               i = i + 1
	           End If
               iReturn = FindNextFile(hFind, wfd)
            End If
         End If
      Loop
   End If

   iReturn = FindClose(hFind)
   GetFileList = true

Done:
   Exit Sub
CatchEx:
   Note Error$()
   Resume Done
End Function

Public Function GetFileDateTime(ByVal FileName As String,
        ByVal NoGMTConvert As Logical) As String
'*************************************************
' GetFileDateTime
' This function returns the Last Modified date/time
' of the specified file name. It returns "" if an error occurred.
'*************************************************

	Dim FileHandle As Integer
	Dim Res As Integer
	Dim ErrNum As Integer
	Dim ErrText As String
	Dim tCreatedFileTime As FileTime
	Dim tAccessedFileTime As FileTime
	Dim tModifiedFileTime As FileTime
	Dim tLocalTime As FileTime
	Dim tSystemTime As SYSTEMTIME
	Dim ResultTime As String
	Dim secAttr as Integer
	
	' Ensure the file exists.
	If Not FileExists(FileName) Then
	    GetFileDateTime = ""
	    Exit Function
	End If
	
	' Here, we use CreateFile to open the existing file
	' named in FileName.  The OPEN_EXISTING flag indicates
	' that we are opening an existing flag.
	FileHandle = CreateFile(FileName, GENERIC_READ, FILE_SHARE_READ, secAttr, OPEN_EXISTING, 0, 0)
	
	If FileHandle = INVALID_HANDLE_VALUE Then
	    ' An error occurred.
	    GetFileDateTime = ""
	    Exit Function
	End If
	
	' Call the GetFileTime function.
	Res = GetFileTime(
	    FileHandle,
	    tCreatedFileTime,
	    tAccessedFileTime,
	    tModifiedFileTime)
	
	If Res = 0 Then
	    ' An error occurred
	    GetFileDateTime = ""
	    Exit Function
	End If
	
	' Convert the FileTime (GMT) to LocalFileTime)
	' if NoGMTConvert is omitted or False.
	If NoGMTConvert = False Then
	    Res = FileTimeToLocalFileTime(tModifiedFileTime, tLocalTime)
	Else
	    ' We are NOT converting from GMT.
	    tLocalTime.dwHighDateTime = tModifiedFileTime.dwHighDateTime
	    tLocalTime.dwLowDateTime = tModifiedFileTime.dwLowDateTime
	    Res = 2
	End If
	
	If Res = 0 Then
	    ' An error occurred
	    GetFileDateTime = ""
	    Exit Function
	End If
	
	' Convert the FileTime to SystemTime
	Res = FileTimeToSystemTime(tLocalTime, tSystemTime)
	If Res = 0 Then
	    ' An error occurred
	    GetFileDateTime = ""
	    Exit Function
	End If
	
	' Convert from Local to string
	ResultTime = tSystemTime.wYear + Format$(tSystemTime.wMonth, "00") + Format$(tSystemTime.wDay, "00") + "_" +
		Format$(tSystemTime.wHour, "00") + Format$(tSystemTime.wMinute, "00") + Format$(tSystemTime.wSecond, "00")
	
	' Close the file
	Res = CloseHandle(FileHandle)
	
	GetFileDateTime = ResultTime

End Function


Function CreatePath(ByVal sPath As String) As Logical
'*************************************************
'* Create/check a complete local or UNC directory.
'* Do not change the application's current directory.
'*************************************************
    OnError Goto Failed
    Dim iResult As Integer, iAttributes As Integer
    CreatePath = False
    sPath = FullPath(sPath)
    If sPath = "" Then Exit Function End If
    iResult = SHCreateDirectoryEx(0, sPath, 0)
    If iResult <> 0 And iResult <> 183 Then Exit Function End If
    iAttributes = GetFileAttributes(sPath)
    If iAttributes = -1 Then Exit Function End If
    CreatePath = (iAttributes Mod 32) >= 16
Failed:
End Function

Function NewWorkingFolder(ByVal sRoot As String, ByVal sPrefix As String) As String
'*************************************************
'* Atomically reserve a fresh run directory.
'*************************************************
    OnError Goto Failed
    Dim sCandidate As String, sStamp As String
    Dim iAttempt As Integer, iResult As Integer
    NewWorkingFolder = ""
    sRoot = FullPath(sRoot)
    If Not CreatePath(sRoot) Then Exit Function End If
    sStamp = Format$(Year(CurDate()), "0000") + Format$(Month(CurDate()), "00") + Format$(Day(CurDate()), "00") + "_" + StringReplace(FormatTime$(CurTime(), "HH:mm:ss"), ":", "")
    For iAttempt = 1 To 100
        sCandidate = sRoot + "\" + sPrefix + "_" + sStamp + "_" + LTrim$(Str$(Int(Rnd(1) * 1000000))) + "_" + LTrim$(Str$(iAttempt))
        iResult = SHCreateDirectoryEx(0, sCandidate, 0)
        If iResult = 0 Then
            NewWorkingFolder = sCandidate
            Exit Function
        End If
        If iResult <> 183 And iResult <> 80 Then Exit Function End If
    Next
Failed:
End Function
